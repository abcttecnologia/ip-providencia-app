rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserProfile()
        && currentUser().ativo == true
        && currentUser().perfil == 'ADMINISTRADOR';
    }

    function hasFuncao(funcao) {
      return hasUserProfile()
        && currentUser().ativo == true
        && currentUser().funcoes is list
        && currentUser().funcoes.hasAny([funcao]);
    }

    function isSecretaria() {
      return hasFuncao('SECRETARIA');
    }

    function isPastoral() {
      return hasFuncao('PASTORAL');
    }

    function isTesouraria() {
      return hasFuncao('TESOURARIA');
    }

    function isStaff() {
      return isAdmin() || isSecretaria() || isPastoral() || isTesouraria();
    }

    function isCareStaff() {
      return isAdmin() || isSecretaria() || isPastoral();
    }

    function canManageContent() {
      return isAdmin() || isSecretaria();
    }

    function isMember() {
      return hasUserProfile()
        && currentUser().ativo == true
        && currentUser().perfil == 'MEMBRO';
    }

    function isMemberOrAdmin() {
      return isMember() || isAdmin();
    }

    function audienceOf(data) {
      return data.keys().hasAny(['publico']) ? data.publico : 'todos';
    }

    function canReadAudience(data) {
      return isAdmin()
        || audienceOf(data) == 'todos'
        || (audienceOf(data) == 'membros' && isMemberOrAdmin())
        || (
          audienceOf(data) == 'ministerio'
          && isMemberOrAdmin()
          && data.alvoId is string
          && currentUser().ministerios is list
          && currentUser().ministerios.hasAny([data.alvoId])
        )
        || (
          audienceOf(data) == 'pg'
          && isMemberOrAdmin()
          && data.alvoId is string
          && currentUser().pequenoGrupoId == data.alvoId
        );
    }

    function validAudience(data) {
      return data.keys().hasAny(['publico'])
        && data.publico in ['todos', 'membros', 'ministerio', 'pg']
        && (
          (
            data.publico in ['todos', 'membros']
            && (
              !data.keys().hasAny(['alvoId'])
              || data.alvoId == null
            )
          )
          || (
            data.publico in ['ministerio', 'pg']
            && data.alvoId is string
            && data.alvoId.size() > 0
          )
        );
    }

    function validOptionalUserFields(data) {
      return (
          !data.keys().hasAny(['telefone'])
          || data.telefone is string
        )
        && (
          !data.keys().hasAny(['endereco'])
          || data.endereco is string
        )
        && (
          !data.keys().hasAny(['dataNascimento'])
          || data.dataNascimento is string
        )
        && (
          !data.keys().hasAny(['estadoCivil'])
          || data.estadoCivil is string
        )
        && (
          !data.keys().hasAny(['fotoUrl'])
          || data.fotoUrl is string
        )
        && (
          !data.keys().hasAny(['familiaId'])
          || data.familiaId == null
          || data.familiaId is string
        )
        && (
          !data.keys().hasAny(['pequenoGrupoId'])
          || data.pequenoGrupoId == null
          || data.pequenoGrupoId is string
        )
        && (
          !data.keys().hasAny(['salaEbdId'])
          || data.salaEbdId == null
          || data.salaEbdId is string
        )
        && (
          !data.keys().hasAny(['ministerios'])
          || data.ministerios is list
        );
    }

    function validConsent(data) {
      return data.keys().hasAny(['consentimentoLgpd'])
        && data.consentimentoLgpd is map
        && data.consentimentoLgpd.keys().hasAll(['versao', 'aceitoEm'])
        && data.consentimentoLgpd.keys().hasOnly(['versao', 'aceitoEm'])
        && data.consentimentoLgpd.versao == '1.0'
        && data.consentimentoLgpd.aceitoEm == request.time;
    }

    function validUserFunctions(data) {
      return !data.keys().hasAny(['funcoes'])
        || (
          data.funcoes is list
          && data.funcoes.size() <= 3
          && data.funcoes.hasOnly([
            'SECRETARIA',
            'PASTORAL',
            'TESOURARIA'
          ])
        );
    }

    function validProfileUpdate(data) {
      return (
          !data.keys().hasAny(['nome'])
          || (
            data.nome is string
            && data.nome.size() > 0
            && data.nome.size() <= 120
          )
        )
        && (
          !data.keys().hasAny(['perfil'])
          || data.perfil in ['VISITANTE', 'MEMBRO', 'ADMINISTRADOR']
        )
        && (
          !data.keys().hasAny(['ativo'])
          || data.ativo is bool
        )
        && (
          !data.keys().hasAny(['membroDesde'])
          || data.membroDesde is timestamp
        )
        && validOptionalUserFields(data)
        && validUserFunctions(data);
    }

    function deletionRequestPath(uid) {
      return /databases/$(database)/documents/solicitacoesExclusao/$(uid);
    }

    function smallGroupPath(grupoId) {
      return /databases/$(database)/documents/pequenosGrupos/$(grupoId);
    }

    function isLiderDoPg(grupoId) {
      return signedIn()
        && grupoId is string
        && exists(smallGroupPath(grupoId))
        && get(smallGroupPath(grupoId)).data.liderUids is list
        && request.auth.uid in get(smallGroupPath(grupoId)).data.liderUids;
    }

    function pgRequestPath(uid, grupoId) {
      return /databases/$(database)/documents/solicitacoesPg/$(grupoId + '_' + uid);
    }

    function hasApprovedPgRequest(uid, grupoId) {
      return existsAfter(pgRequestPath(uid, grupoId))
        && getAfter(pgRequestPath(uid, grupoId)).data.uid == uid
        && getAfter(pgRequestPath(uid, grupoId)).data.grupoId == grupoId
        && getAfter(pgRequestPath(uid, grupoId)).data.status == 'aprovada';
    }

    function pendingLgpdRequest(uid) {
      return exists(deletionRequestPath(uid))
        && !exists(userPath(uid))
        && get(deletionRequestPath(uid)).data.uid == uid
        && get(deletionRequestPath(uid)).data.status == 'pendente'
        && get(deletionRequestPath(uid)).data.motivoExclusao == 'lgpd';
    }

    function pendingAdminAnonymization(uid) {
      return pendingLgpdRequest(uid)
        && get(deletionRequestPath(uid)).data.anonimizacaoAdminOk == false;
    }

    function pendingPastoralAnonymization(uid) {
      return pendingLgpdRequest(uid)
        && get(deletionRequestPath(uid)).data.anonimizacaoPastoralOk == false;
    }

    function validAudit(data) {
      return data.keys().hasAll([
          'acao',
          'colecao',
          'docId',
          'por',
          'porNome',
          'em'
        ])
        && data.keys().hasOnly([
          'acao',
          'colecao',
          'docId',
          'por',
          'porNome',
          'em'
        ])
        && data.acao in ['criar', 'editar', 'excluir', 'anonimizar']
        && data.colecao is string
        && data.docId is string
        && data.por == request.auth.uid
        && data.porNome is string
        && data.em == request.time;
    }

    function validDeletionRequest(uid, data) {
      return data.keys().hasAll([
          'uid',
          'nome',
          'email',
          'status',
          'criadoEm',
          'motivoExclusao',
          'anonimizacaoAdminOk',
          'anonimizacaoPastoralOk'
        ])
        && data.keys().hasOnly([
          'uid',
          'nome',
          'email',
          'status',
          'criadoEm',
          'motivoExclusao',
          'anonimizacaoAdminOk',
          'anonimizacaoPastoralOk'
        ])
        && data.uid == uid
        && data.nome is string
        && data.email is string
        && data.status == 'pendente'
        && data.criadoEm == request.time
        && data.motivoExclusao == 'lgpd'
        && data.anonimizacaoAdminOk == false
        && data.anonimizacaoPastoralOk == false;
    }

    function validMemberHistory(data) {
      return data.keys().hasAll([
          'pessoaUid',
          'tipo',
          'data',
          'descricao',
          'criadoPor',
          'criadoPorNome',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'pessoaUid',
          'tipo',
          'data',
          'descricao',
          'criadoPor',
          'criadoPorNome',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.pessoaUid is string
        && data.pessoaUid.size() > 0
        && data.pessoaUid.size() <= 128
        && exists(userPath(data.pessoaUid))
        && data.tipo in ['admissao', 'batismo', 'transferencia', 'observacao']
        && data.data is timestamp
        && data.data >= timestamp.date(1900, 1, 1)
        && data.data < timestamp.date(2200, 1, 1)
        && data.descricao is string
        && data.descricao.size() > 0
        && data.descricao.size() <= 2000
        && data.criadoPor is string
        && data.criadoPorNome is string
        && data.criadoPorNome.size() > 0
        && data.criadoPorNome.size() <= 120;
    }

    function validRecordTarget(data) {
      return (
          data.alvoTipo == 'pessoa'
          && exists(userPath(data.alvoId))
        )
        || (
          data.alvoTipo == 'familia'
          && exists(
            /databases/$(database)/documents/familias/$(data.alvoId)
          )
        );
    }

    function validPastoralVisit(data) {
      return data.keys().hasAll([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'data',
          'motivo',
          'visitante',
          'observacoes',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'data',
          'motivo',
          'visitante',
          'observacoes',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.alvoTipo in ['pessoa', 'familia']
        && data.alvoId is string
        && data.alvoId.size() > 0
        && data.alvoId.size() <= 128
        && data.alvoNome is string
        && data.alvoNome.size() > 0
        && data.alvoNome.size() <= 120
        && data.data is timestamp
        && data.data >= timestamp.date(1900, 1, 1)
        && data.data < timestamp.date(2200, 1, 1)
        && data.motivo is string
        && data.motivo.size() <= 160
        && data.visitante is string
        && data.visitante.size() > 0
        && data.visitante.size() <= 120
        && data.observacoes is string
        && data.observacoes.size() <= 2000
        && data.status in ['agendada', 'realizada', 'cancelada']
        && data.criadoPor is string
        && validRecordTarget(data);
    }

    function validPastoralFollowUp(data) {
      return data.keys().hasAll([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'categoria',
          'necessidade',
          'responsavel',
          'proximoRetorno',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'categoria',
          'necessidade',
          'responsavel',
          'proximoRetorno',
          'status',
          'criadoPor',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.alvoTipo in ['pessoa', 'familia']
        && data.alvoId is string
        && data.alvoId.size() > 0
        && data.alvoId.size() <= 128
        && data.alvoNome is string
        && data.alvoNome.size() > 0
        && data.alvoNome.size() <= 120
        && data.categoria in ['espiritual', 'saude', 'familia', 'social', 'outro']
        && data.necessidade is string
        && data.necessidade.size() > 0
        && data.necessidade.size() <= 2000
        && data.responsavel is string
        && data.responsavel.size() > 0
        && data.responsavel.size() <= 120
        && data.proximoRetorno is timestamp
        && data.proximoRetorno >= timestamp.date(1900, 1, 1)
        && data.proximoRetorno < timestamp.date(2200, 1, 1)
        && data.status in ['aberto', 'em_andamento', 'concluido']
        && data.criadoPor is string
        && validRecordTarget(data);
    }

    function ownsToken(tokenData) {
      return signedIn() && tokenData.uid == request.auth.uid;
    }

    function validPushToken(data) {
      return data.keys().hasAll([
          'uid',
          'plataforma',
          'ativo',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uid',
          'plataforma',
          'ativo',
          'atualizadoEm'
        ])
        && data.plataforma in ['ios', 'android']
        && data.ativo is bool
        && data.atualizadoEm == request.time;
    }

    function belongsToSmallGroup(groupId) {
      return isMemberOrAdmin()
        && currentUser().pequenoGrupoId == groupId;
    }

    function isSmallGroupParticipant(groupId) {
      return signedIn()
        && hasUserProfile()
        && currentUser().ativo == true
        && currentUser().perfil == 'MEMBRO'
        && currentUser().pequenoGrupoId == groupId;
    }

    function validPgRequest(data, uid, grupoId) {
      return data.keys().hasAll([
          'uid',
          'nome',
          'grupoId',
          'status',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'uid',
          'nome',
          'grupoId',
          'status',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.uid == uid
        && data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 120
        && data.grupoId == grupoId
        && data.status == 'pendente'
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time;
    }

    function validPgAttendance(data, groupId, date) {
      return data.keys().hasAll([
          'grupoId',
          'data',
          'presentes',
          'visitantes',
          'registradoPor',
          'registradoEm'
        ])
        && data.keys().hasOnly([
          'grupoId',
          'data',
          'presentes',
          'visitantes',
          'registradoPor',
          'registradoEm'
        ])
        && data.grupoId == groupId
        && data.data == date
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.presentes is list
        && data.visitantes is int
        && data.visitantes >= 0
        && data.registradoPor == request.auth.uid
        && data.registradoEm == request.time;
    }

    function validPrayerSharing(data) {
      return (
          data.compartilhadoComPg == false
          && data.pequenoGrupoId == null
        )
        || (
          data.compartilhadoComPg == true
          && data.pequenoGrupoId is string
          && isMember()
          && currentUser().pequenoGrupoId == data.pequenoGrupoId
        );
    }

    function validPrayerCreate(data) {
      return data.keys().hasAll([
          'autorUid',
          'titulo',
          'texto',
          'compartilhadoComPg',
          'pequenoGrupoId',
          'status',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'autorUid',
          'titulo',
          'texto',
          'compartilhadoComPg',
          'pequenoGrupoId',
          'status',
          'criadoEm',
          'atualizadoEm'
        ])
        && data.titulo is string
        && data.titulo.size() > 0
        && data.titulo.size() <= 100
        && data.texto is string
        && data.texto.size() > 0
        && data.texto.size() <= 2000
        && data.status == 'aberto'
        && data.criadoEm == request.time
        && data.atualizadoEm == request.time
        && (
          (
            !signedIn()
            && data.autorUid == null
            && data.compartilhadoComPg == false
            && data.pequenoGrupoId == null
          )
          || (
            signedIn()
            && data.autorUid == request.auth.uid
            && validPrayerSharing(data)
          )
        );
    }

    match /Avisos/{documentId} {
      allow get, list: if canReadAudience(resource.data);
      allow create: if canManageContent()
        && validAudience(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['categoria'])
          || request.resource.data.categoria in [
            'geral',
            'ministerio',
            'comunhao'
          ]
        );
      allow update: if canManageContent()
        && validAudience(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['categoria'])
          || request.resource.data.categoria in [
            'geral',
            'ministerio',
            'comunhao'
          ]
        );
      allow delete: if canManageContent();
    }

    match /biblioteca/{documentId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /campanha/{documentId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /config/{documentId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /eventos/{documentId} {
      allow get, list: if canReadAudience(resource.data);
      allow create, update: if canManageContent()
        && validAudience(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['categoria'])
          || request.resource.data.categoria is string
        );
      allow delete: if canManageContent();
    }

    match /versiculo/{documentId} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /pushTokens/{tokenId} {
      allow read: if isAdmin() || ownsToken(resource.data);
      allow create: if isAdmin() || (
        ownsToken(request.resource.data)
        && validPushToken(request.resource.data)
        && request.resource.data.ativo == true
      );
      allow update: if isAdmin() || (
        ownsToken(request.resource.data)
        && validPushToken(request.resource.data)
      );
      allow delete: if isAdmin() || ownsToken(resource.data);
    }


    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isCareStaff();
      allow list: if isCareStaff();
      allow create: if signedIn()
        && request.auth.uid == uid
        && !exists(deletionRequestPath(uid))
        && request.resource.data.keys().hasAll([
          'uid',
          'email',
          'nome',
          'perfil',
          'ativo',
          'ministerios',
          'criadoEm',
          'atualizadoEm',
          'consentimentoLgpd'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'nome',
          'perfil',
          'ativo',
          'ministerios',
          'criadoEm',
          'atualizadoEm',
          'consentimentoLgpd'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.perfil == 'VISITANTE'
        && request.resource.data.ativo == true
        && request.resource.data.ministerios is list
        && request.resource.data.ministerios.size() == 0
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time
        && validConsent(request.resource.data);
      allow update: if (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome',
            'telefone',
            'endereco',
            'dataNascimento',
            'estadoCivil',
            'fotoUrl',
            'atualizadoEm'
          ])
          && request.resource.data.atualizadoEm == request.time
          && validOptionalUserFields(request.resource.data)
        )
        || (
          signedIn()
          && request.auth.uid == uid
          && resource.data.keys().hasAny(['consentimentoLgpd']) == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['consentimentoLgpd'])
          && validConsent(request.resource.data)
        )
        || (
          isCareStaff()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome',
            'telefone',
            'endereco',
            'dataNascimento',
            'estadoCivil',
            'familiaId',
            'pequenoGrupoId',
            'salaEbdId',
            'ministerios',
            'membroDesde',
            'atualizadoEm'
          ])
          && request.resource.data.atualizadoEm == request.time
          && validProfileUpdate(request.resource.data)
        )
        || (
          isAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome',
            'telefone',
            'endereco',
            'dataNascimento',
            'estadoCivil',
            'familiaId',
            'pequenoGrupoId',
            'salaEbdId',
            'ministerios',
            'membroDesde',
            'perfil',
            'ativo',
            'funcoes',
            'atualizadoEm'
          ])
          && request.resource.data.atualizadoEm == request.time
          && validProfileUpdate(request.resource.data)
        )
        || (
          isAdmin()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nome',
            'telefone',
            'endereco',
            'dataNascimento',
            'estadoCivil',
            'familiaId',
            'pequenoGrupoId',
            'salaEbdId',
            'ministerios',
            'membroDesde',
            'perfil',
            'ativo',
            'atualizadoEm'
          ])
          && request.resource.data.atualizadoEm == request.time
          && validProfileUpdate(request.resource.data)
        )
        || (
          signedIn()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pequenoGrupoId',
            'atualizadoEm'
          ])
          && request.resource.data.atualizadoEm == request.time
          && (
            (
              request.resource.data.pequenoGrupoId == null
              && resource.data.pequenoGrupoId is string
              && isLiderDoPg(resource.data.pequenoGrupoId)
            )
            || (
              request.resource.data.pequenoGrupoId is string
              && (
                !resource.data.keys().hasAny(['pequenoGrupoId'])
                || resource.data.pequenoGrupoId == null
              )
              && resource.data.ativo == true
              && resource.data.perfil == 'MEMBRO'
              && isLiderDoPg(request.resource.data.pequenoGrupoId)
              && hasApprovedPgRequest(uid, request.resource.data.pequenoGrupoId)
            )
          )
        );
      allow delete: if signedIn()
        && request.auth.uid == uid
        && existsAfter(deletionRequestPath(uid))
        && getAfter(deletionRequestPath(uid)).data.uid == uid
        && getAfter(deletionRequestPath(uid)).data.status == 'pendente'
        && getAfter(deletionRequestPath(uid)).data.motivoExclusao == 'lgpd';
    }

    match /ministerios/{ministerioId} {
      allow get: if isAdmin()
        || (
          isMember()
          && currentUser().ministerios is list
          && currentUser().ministerios.hasAny([ministerioId])
        );
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pequenosGrupos/{grupoId} {
      allow get, list: if isCareStaff()
        || resource.data.ativo == true
        || belongsToSmallGroup(grupoId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isSecretaria()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'liderUids',
            'atualizadoEm'
          ])
          && request.resource.data.liderUids is list
          && request.resource.data.atualizadoEm == request.time
        );

      match /participantes/{uid} {
        allow get, list: if isCareStaff()
          || isLiderDoPg(grupoId)
          || isSmallGroupParticipant(grupoId);
        allow create, update, delete: if false;
      }

      match /participantesMeta/{uid} {
        allow get, list: if isCareStaff();
        allow create, update, delete: if false;
      }
    }

    match /solicitacoesPg/{solicitacaoId} {
      allow get, list: if isCareStaff()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || isLiderDoPg(resource.data.grupoId);
      allow create: if isMember()
        && request.resource.data.grupoId is string
        && exists(smallGroupPath(request.resource.data.grupoId))
        && get(smallGroupPath(request.resource.data.grupoId)).data.ativo == true
        && solicitacaoId == request.resource.data.grupoId + '_' + request.auth.uid
        && validPgRequest(
          request.resource.data,
          request.auth.uid,
          request.resource.data.grupoId
        );
      allow update: if (
        isCareStaff() || isLiderDoPg(resource.data.grupoId)
      )
        && resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'atualizadoEm'
        ])
        && request.resource.data.status in ['aprovada', 'recusada']
        && request.resource.data.atualizadoEm == request.time
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.grupoId == resource.data.grupoId
        && request.resource.data.nome == resource.data.nome
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (
          isCareStaff()
          || resource.data.uid != request.auth.uid
        );
      allow delete: if false;
    }

    match /presencasPg/{presencaId} {
      allow get, list: if isCareStaff()
        || isLiderDoPg(resource.data.grupoId);
      allow create: if request.resource.data.grupoId is string
        && isLiderDoPg(request.resource.data.grupoId)
        && presencaId == request.resource.data.grupoId + '_' + request.resource.data.data
        && validPgAttendance(
          request.resource.data,
          request.resource.data.grupoId,
          request.resource.data.data
        );
      allow update: if resource.data.grupoId == request.resource.data.grupoId
        && isLiderDoPg(resource.data.grupoId)
        && presencaId == request.resource.data.grupoId + '_' + request.resource.data.data
        && validPgAttendance(
          request.resource.data,
          resource.data.grupoId,
          resource.data.data
        );
      allow delete: if false;
    }

    match /salasEbd/{salaId} {
      allow get: if isAdmin()
        || (isMember() && currentUser().salaEbdId == salaId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /familias/{familiaId} {
      allow get: if isCareStaff()
        || (
          signedIn()
          && hasUserProfile()
          && currentUser().familiaId == familiaId
        );
      allow list: if isCareStaff();
      allow create, update, delete: if isCareStaff();
    }

    match /historicoMembros/{registroId} {
      allow get, list: if isCareStaff();
      allow create: if isCareStaff()
        && validMemberHistory(request.resource.data)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoPorNome == currentUser().nome
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if isCareStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tipo',
          'data',
          'descricao',
          'atualizadoEm'
        ])
        && validMemberHistory(request.resource.data)
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if isAdmin()
        && pendingAdminAnonymization(resource.data.pessoaUid);
    }

    match /visitas/{visitaId} {
      allow get, list: if isCareStaff();
      allow create: if isCareStaff()
        && validPastoralVisit(request.resource.data)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if (
        isCareStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'data',
          'motivo',
          'visitante',
          'observacoes',
          'status',
          'atualizadoEm'
        ])
        && validPastoralVisit(request.resource.data)
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time
      ) || (
        isAdmin()
        && resource.data.alvoTipo == 'pessoa'
        && pendingAdminAnonymization(resource.data.alvoId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'alvoNome',
          'motivo',
          'observacoes',
          'atualizadoEm'
        ])
        && request.resource.data.alvoNome == 'Removido a pedido do titular'
        && request.resource.data.motivo == ''
        && request.resource.data.observacoes == ''
        && request.resource.data.atualizadoEm == request.time
      );
      allow delete: if false;
    }

    match /acompanhamentos/{acompanhamentoId} {
      allow get, list: if isPastoral();
      allow create: if isPastoral()
        && validPastoralFollowUp(request.resource.data)
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if (
        isPastoral()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'alvoTipo',
          'alvoId',
          'alvoNome',
          'categoria',
          'necessidade',
          'responsavel',
          'proximoRetorno',
          'status',
          'atualizadoEm'
        ])
        && validPastoralFollowUp(request.resource.data)
        && request.resource.data.criadoPor == resource.data.criadoPor
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time
      ) || (
        isPastoral()
        && resource.data.alvoTipo == 'pessoa'
        && pendingPastoralAnonymization(resource.data.alvoId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'alvoNome',
          'necessidade',
          'atualizadoEm'
        ])
        && request.resource.data.alvoNome == 'Removido a pedido do titular'
        && request.resource.data.necessidade == ''
        && request.resource.data.atualizadoEm == request.time
      );
      allow delete: if false;
    }

    match /pedidosOracao/{pedidoId} {
      allow get, list: if isPastoral()
        || (
          signedIn()
          && resource.data.autorUid == request.auth.uid
        )
        || (
          resource.data.compartilhadoComPg == true
          && (
            belongsToSmallGroup(resource.data.pequenoGrupoId)
            || isLiderDoPg(resource.data.pequenoGrupoId)
          )
        );
      allow create: if validPrayerCreate(request.resource.data);
      allow update: if (
            isPastoral()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'atualizadoEm'
            ])
            && request.resource.data.status in ['aberto', 'respondido', 'arquivado']
            && request.resource.data.atualizadoEm == request.time
        )
        || (
          signedIn()
          && resource.data.autorUid == request.auth.uid
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'titulo',
            'texto',
            'compartilhadoComPg',
            'pequenoGrupoId',
            'atualizadoEm'
          ])
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 100
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.atualizadoEm == request.time
          && validPrayerSharing(request.resource.data)
        );
      allow delete: if signedIn()
        && resource.data.autorUid == request.auth.uid;

      match /respostas/{respostaId} {
        function prayerRequestExists() {
          return exists(
            /databases/$(database)/documents/pedidosOracao/$(pedidoId)
          );
        }

        function prayerRequestAuthor() {
          return get(
            /databases/$(database)/documents/pedidosOracao/$(pedidoId)
          ).data.autorUid;
        }

        function validPastoralResponse(data) {
          return data.keys().hasAll(['texto', 'por', 'porNome', 'em'])
            && data.keys().hasOnly(['texto', 'por', 'porNome', 'em'])
            && data.texto is string
            && data.texto.size() > 0
            && data.texto.size() <= 2000
            && data.por == request.auth.uid
            && data.porNome is string
            && data.porNome.size() > 0
            && data.porNome.size() <= 120
            && data.porNome == currentUser().nome
            && data.em == request.time;
        }

        allow get, list: if prayerRequestExists()
          && (
            isPastoral()
            || (
              signedIn()
              && prayerRequestAuthor() == request.auth.uid
            )
          );
        allow create, update: if respostaId == 'pastoral'
          && isPastoral()
          && prayerRequestExists()
          && prayerRequestAuthor() is string
          && validPastoralResponse(request.resource.data);
        allow delete: if prayerRequestExists()
          && signedIn()
          && prayerRequestAuthor() == request.auth.uid;
      }
    }

    match /auditoria/{auditId} {
      allow create: if isStaff()
        && validAudit(request.resource.data);
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /solicitacoesExclusao/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validDeletionRequest(uid, request.resource.data)
        && request.resource.data.email == request.auth.token.email;
      allow get, list: if isAdmin() || isPastoral();
      allow update: if (
        isAdmin()
        && resource.data.status == 'pendente'
        && resource.data.motivoExclusao == 'lgpd'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['anonimizacaoAdminOk', 'status'])
        && request.resource.data.anonimizacaoAdminOk == true
        && request.resource.data.anonimizacaoPastoralOk
          == resource.data.anonimizacaoPastoralOk
        && (
          request.resource.data.status == 'pendente'
          || (
            request.resource.data.status == 'concluida'
            && request.resource.data.anonimizacaoPastoralOk == true
          )
        )
      ) || (
        isPastoral()
        && resource.data.status == 'pendente'
        && resource.data.motivoExclusao == 'lgpd'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['anonimizacaoPastoralOk'])
        && resource.data.anonimizacaoPastoralOk == false
        && request.resource.data.anonimizacaoPastoralOk == true
      );
      allow delete: if false;
    }

    match /anotacoes/{anotacaoId} {
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid',
          'titulo',
          'conteudo',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'titulo',
          'conteudo',
          'referenciaBiblica',
          'criadoEm',
          'atualizadoEm'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.conteudo is string
        && request.resource.data.criadoEm == request.time
        && request.resource.data.atualizadoEm == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'titulo',
          'conteudo',
          'referenciaBiblica',
          'atualizadoEm'
        ])
        && request.resource.data.titulo is string
        && request.resource.data.conteudo is string
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
